# ---------------------------------------------------------------------------
# Environment template — copy this file to `.env.local` and fill in a value.
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored (see .gitignore → `.env*.local`) so every
# developer / machine / network keeps its own value without ever editing
# source code. Restart `npx expo start` after changing it — Expo inlines
# `EXPO_PUBLIC_*` values at bundle time.
#
# RECOMMENDED — just run `npm run dev:lan`. It auto-detects the
# laptop's current LAN IPv4 on every run, probes the backend, and
# writes the URL here for you. Switching Wi-Fi / rebooting / changing
# networks after that needs no source edits — re-run `npm run dev:lan`
# and Expo comes up against the fresh IP.
#
# Leave this UNSET on an Android emulator / iOS simulator — the app
# falls back to probing the loopback aliases automatically.
# ---------------------------------------------------------------------------

# Stable backend base URL. Drives BOTH the REST client and the WebSocket
# tracking channel (ws/wss is derived from this single value), so this is
# the only URL you ever configure.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080